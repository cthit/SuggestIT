# Copy to `.env` (gitignored) and fill in. docker compose reads this file
# automatically; the values are passed to the backend container.

# Gamma 2 OIDC client (create one at https://auth.chalmers.it with the
# redirect URI http://localhost:3000/callback).
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Optional overrides (defaults shown).
# OAUTH_URL=https://auth.chalmers.it
# CALLBACK_URL=http://localhost:3000/callback

# Secret used to sign and encrypt session cookies, at least 32 bytes.
# Generate one with: openssl rand -base64 48
# If left empty in dev a random secret is generated on every backend start,
# which logs everyone out when the backend restarts.
SESSION_SECRET=
